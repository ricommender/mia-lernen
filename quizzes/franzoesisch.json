        "correctIndex": 0,
        "feedback": "«Vous comprenez» ist die richtige Form zu vous."
      },
      {
        "id": "fr-pres-06",
        "text": "Ils ___ au tennis. (jouer)",
        "options": [
          "jouons",
          "jouent",
          "jouez"
        ],
        "correctIndex": 1,
        "feedback": "«Ils jouent» endet im Präsens auf -ent; diese Endung wird normalerweise nicht gesprochen."
      }
